# ==========================================
# SERVIDOR & SEGURANÇA
# ==========================================
NODE_ENV=development
PORT=3000
# Em produção, definir exatamente a URL da Vercel (ex: https://aether.vercel.app)
CORS_ORIGIN=http://localhost:5173

# ==========================================
# BANCO DE DADOS (MongoDB)
# ==========================================
# Base oficial (Atlas — uso diário em dev e produção)
MONGO_URI=mongodb+srv://<usuario>:<senha>@cluster0.xxxxx.mongodb.net/aether?retryWrites=true&w=majority

# Base local (Docker) — exclusiva para Jest, Supertest e testes exaustivos de insert
MONGO_TEST_URI=mongodb://127.0.0.1:27017/aether_test

# ==========================================
# AUTENTICAÇÃO DO PAINEL (Admin Único + JWT)
# ==========================================
ADMIN_USERNAME=admin
# Hash bcrypt da senha mestre (use aspas simples para evitar interpolação dos caracteres '$')
ADMIN_PASSWORD_HASH='$2b$10$substitua_pelo_hash_bcrypt_gerado'
JWT_SECRET=substitua_por_uma_string_aleatoria_longa_64_chars
JWT_EXPIRES_IN=7d

# ==========================================
# INGESTÃO DE TELEMETRIA (Heartbeat da VM)
# ==========================================
INGEST_API_KEY=substitua_por_uma_chave_secreta_independente

# ==========================================
# INTEGRAÇÃO N8N
# ==========================================
N8N_BASE_URL=https://n8n.seudominio.com
N8N_API_KEY=substitua_pela_api_key_do_n8n

# ==========================================
# INTEGRAÇÃO SUPABASE (Referenciadas por supabaseKeyEnvRef no seed)
# ==========================================
SUPABASE_PORTFOLIO_URL=substitua_pela_url_do_projeto_projeto_web
SUPABASE_PORTFOLIO_ANON_KEY=substitua_pela_anon_key_do_projeto_projeto_web

SUPABASE_N8N_URL=substitua_pela_url_do_projeto_projeto_automacao
SUPABASE_TACO_ANON_KEY=substitua_pela_anon_key_do_projeto_projeto_automacao

# ==========================================
# ALERTAS (Telegram Bot API)
# ==========================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789